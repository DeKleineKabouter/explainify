{
  "name": "explainify",
  "displayName": "Explainify",
  "description": "AI-powered vulnerability analysis",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],

  "main": "./out/extension.js",
  
  "contributes": {
    "commands": [
      {
        "command": "explainify.analyzeWorkspace",
        "title": "Explainify: Scan for Vulnerabilities"
      }
    ],
    "themes": [
      {
        "label": "Explainify Bright Warnings",
        "uiTheme": "vs-dark",
        "path": "./themes/explainify-theme.json"
      }
    ],
    "configuration": {
    "title": "Explainify",
      "properties": {
        "explainify.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter used to run the analysis script."
        },
        "explainify.semgrep.config": {
          "type": "string",
          "default": "auto",
          "description": "Semgrep --config value: auto, a registry ruleset (p/java), or a path to rule files."
        },
        "explainify.explanation.detailed": {
          "type": "boolean",
          "default": true,
          "description": "Include exploit scenario, why it happens, and security implications. Otherwise, only explain the cause and fix."
        },
        "explainify.explanation.level": {
          "type": "string",
          "default": "beginner",
          "description": "The level of experience in software security of the user. E.g. 'beginner', 'intermediate', 'expert', '10 years of'."
        }
      }
    }
  },
  
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.19.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}